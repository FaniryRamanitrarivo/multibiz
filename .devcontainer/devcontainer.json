{
    // Lightweight Codespace: PHP, Node, Postgres and Redis all run in
    // backend/docker-compose.yml, so the host only needs Docker, git and gh
    // (instead of the ~25 GB default "universal" image).
    "name": "MultiBiz",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
    },
    "forwardPorts": [8000, 5173, 8025],
    "portsAttributes": {
        "8000": { "label": "Laravel" },
        // The browser loads JS straight from Vite: a private port gets
        // redirected to GitHub sign-in and the page stays blank.
        "5173": { "label": "Vite", "visibility": "public" },
        "8025": { "label": "Mailpit" }
    },
    "otherPortsAttributes": { "onAutoForward": "silent" },
    "postStartCommand": "sudo iptables-legacy -P FORWARD ACCEPT 2>/dev/null || true; cd backend && [ -f .env ] || cp .env.example .env; docker compose up -d"
 
}
